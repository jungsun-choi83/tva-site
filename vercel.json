{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.eternalbeam.com" }],
      "destination": "https://eternalbeam.com/:path*",
      "permanent": true
    },
    {
      "source": "/assets/og/tva-og-1200x630.jpg",
      "destination": "/share-card.jpg",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/share-card.jpg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=60, must-revalidate" }]
    },
    {
      "source": "/assets/og/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=120, must-revalidate" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/gallery-assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/gallery-original/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sofa-journey/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/room-entry/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/vendor/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.(css|js|mjs)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=600, must-revalidate" }]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-store" }]
    },
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, no-store" }]
    },
    {
      "source": "/(sitemap.xml|robots.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
